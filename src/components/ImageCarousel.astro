---
import { Image } from 'astro:assets';

import img01 from '@assets/interactive/slide-01.png';
import img02 from '@assets/interactive/slide-02.png';
import img03 from '@assets/interactive/slide-03.png';
import img04 from '@assets/interactive/slide-04.png';
import img05 from '@assets/interactive/slide-05.png';
import img06 from '@assets/interactive/slide-06.png';

const slides = [
  { src: img01, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
  { src: img02, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
  { src: img03, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
  { src: img04, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
  { src: img05, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
  { src: img06, alt: 'Formación de ciberseguridad para Centro Criptológico Nacional' },
];
---

<div class="carousel-wrap" data-carousel>
  <div class="carousel-viewport">
    <div class="carousel-track">
      {slides.map((slide, i) => (
        <div class="carousel-slide" data-slide={i}>
          <Image
            src={slide.src}
            alt={slide.alt}
            width={1200}
            height={750}
            loading={i === 0 ? 'eager' : 'lazy'}
            class="carousel-img"
          />
        </div>
      ))}
    </div>
  </div>

  <button class="carousel-arrow carousel-arrow--prev" data-prev aria-label="Previous slide">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button class="carousel-arrow carousel-arrow--next" data-next aria-label="Next slide">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<style>
  .carousel-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .carousel-viewport {
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    will-change: transform;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .carousel-slide {
    flex: 0 0 100%;
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .carousel-arrow:hover {
    transform: translateY(-50%) scale(1.1);
    background: rgba(255, 255, 255, 1);
  }

  .carousel-arrow--prev {
    left: 12px;
  }

  .carousel-arrow--next {
    right: 12px;
  }

  .carousel-wrap:hover .carousel-arrow {
    opacity: 1;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll('[data-carousel]').forEach((wrap) => {
      const track = wrap.querySelector('.carousel-track') as HTMLElement;
      const slides = wrap.querySelectorAll('[data-slide]');
      const prevBtn = wrap.querySelector('[data-prev]');
      const nextBtn = wrap.querySelector('[data-next]');
      if (!track || slides.length < 2) return;

      let current = 0;
      const total = slides.length;
      let timer: ReturnType<typeof setInterval>;

      function goTo(index: number) {
        current = (index + total) % total;
        track.style.transform = `translateX(-${current * 100}%)`;
      }

      function startAuto() {
        timer = setInterval(() => goTo(current + 1), 4500);
      }

      function resetAuto() {
        clearInterval(timer);
        startAuto();
      }

      prevBtn?.addEventListener('click', () => {
        goTo(current - 1);
        resetAuto();
      });

      nextBtn?.addEventListener('click', () => {
        goTo(current + 1);
        resetAuto();
      });

      startAuto();
    });
  }

  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
