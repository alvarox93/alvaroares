---
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import { useTranslations, defaultLang, type Language, type UIKey } from '@i18n/ui';
import IconChat from '@components/icons/IconChat.astro';
import IconChevron from '@components/icons/IconChevron.astro';
import IconArrowUpRight from '@components/icons/IconArrowUpRight.astro';

const lang = (Astro.currentLocale ?? defaultLang) as Language;
const t = useTranslations(lang);
const homeHref = lang === defaultLang ? '/' : `/${lang}`;
const aboutHref = lang === defaultLang ? '/about' : '/es/about';

const nameChars = 'Álvaro Ares'.split('');
const workChars = t('nav.work').split('');
const aboutChars = t('nav.about').split('');

const workProjects: Array<{
  slug: 'studio' | 'renders' | 'branding' | 'interactive';
  num: string;
  labelKey: UIKey;
  tagKey: UIKey;
  transitionKey: string;
}> = [
  { slug: 'studio', num: '01', labelKey: 'nav.work.studio', tagKey: 'work.koora.tag', transitionKey: 'transition.koora.line1' },
  { slug: 'renders', num: '02', labelKey: 'nav.work.renders', tagKey: 'work.renders.tag', transitionKey: 'transition.renders.line1' },
  { slug: 'branding', num: '03', labelKey: 'nav.work.branding', tagKey: 'work.lapatzak.tag', transitionKey: 'transition.lapatzak.line1' },
  { slug: 'interactive', num: '04', labelKey: 'nav.work.lab', tagKey: 'work.lab.tag', transitionKey: 'transition.lab.line1' },
];

const projectHref = (slug: string) => lang === defaultLang ? `/${slug}` : `/es/${slug}`;
---

<nav class="fixed top-0 left-0 right-0 z-50" id="main-nav">
  <div class="max-w-[1200px] mx-auto px-xl lg:px-3xl flex items-center justify-between h-16">
    <a
      href={homeHref}
      data-transition-line1={t('transition.home.line1')}
      data-transition-line2={t('transition.home.line2')}
      class="nav-char-link nav-name text-ink text-[15px] font-medium tracking-[-0.3px]"
    >
      <span class="nav-text">
        {nameChars.map((char) => (
          <span class="nav-char">{char === ' ' ? '\u00A0' : char}</span>
        ))}
      </span>
    </a>

    {/* Desktop nav */}
    <div class="hidden md:flex items-center gap-lg">
      <button
        type="button"
        class="nav-char-link nav-trigger nav-work text-[13px] font-normal tracking-[-0.2px]"
        data-work-trigger
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="work-dropdown"
      >
        <span class="nav-text">
          {workChars.map((char) => (
            <span class="nav-char">{char === ' ' ? '\u00A0' : char}</span>
          ))}
        </span>
        <IconChevron class="work-chevron" />
      </button>
      <a
        href={aboutHref}
        data-transition-line1={t('transition.about.line1')}
        data-transition-line2={t('transition.about.line2')}
        class="nav-char-link nav-about text-[13px] font-normal tracking-[-0.2px]"
      >
        <span class="nav-text">
          {aboutChars.map((char) => (
            <span class="nav-char">{char === ' ' ? '\u00A0' : char}</span>
          ))}
        </span>
      </a>
      <a href="mailto:hey@alvaroar.es" class="inline-flex items-center gap-1.5 justify-center px-4 py-2 bg-ink text-canvas text-[12px] font-medium tracking-[-0.2px] rounded-lg transition-colors duration-300 hover:bg-ink/85">
        <IconChat />
        {t('nav.contact.talk')}
      </a>
      <button class="theme-knob" aria-label="Toggle color theme" data-theme-knob>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <LanguageSwitcher />
    </div>

    {/* Mobile burger */}
    <button
      class="md:hidden burger-btn relative w-10 h-10 flex items-center justify-center"
      aria-label="Open menu"
      aria-expanded="false"
      data-burger
    >
      <span class="burger-line burger-line-1"></span>
      <span class="burger-line burger-line-2"></span>
    </button>
  </div>

  {/* Work dropdown (desktop) */}
  <div
    class="work-dropdown"
    id="work-dropdown"
    role="menu"
    aria-label={t('nav.work')}
    data-work-dropdown
  >
    <div class="work-dropdown-inner">
      <div class="work-dropdown-panel">
        {workProjects.map((p) => (
          <a
            href={projectHref(p.slug)}
            role="menuitem"
            data-transition-line1={t(p.transitionKey as UIKey)}
            data-transition-line2=""
            class="work-dropdown-item"
          >
            <span class="work-item-num">{p.num}</span>
            <span class="work-item-body">
              <span class="work-item-label">{t(p.labelKey)}</span>
              <span class="work-item-tag">{t(p.tagKey)}</span>
            </span>
            <IconArrowUpRight class="work-item-arrow" />
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

{/* Mobile full-screen menu */}
<div class="mobile-menu fixed inset-0 z-40 pointer-events-none" data-mobile-menu>
  <div class="mobile-menu-backdrop absolute inset-0 bg-canvas" data-menu-backdrop></div>
  <div class="mobile-menu-content relative h-full flex flex-col justify-between px-xl py-2xl opacity-0" data-menu-content>
    {/* Top: about link */}
    <div></div>

    {/* Center: main links */}
    <div class="flex flex-col items-center gap-xl">
      <a
        href={aboutHref}
        data-transition-line1={t('transition.about.line1')}
        data-transition-line2={t('transition.about.line2')}
        class="mobile-menu-link text-ink text-[32px] font-semibold tracking-[-0.6px]"
      >{t('nav.about')}</a>
      <div class="flex flex-col items-center gap-sm">
        <span class="text-ink text-[32px] font-semibold tracking-[-0.6px] opacity-60">{t('nav.work')}</span>
        <div class="flex flex-col items-center gap-xs mt-xs">
          {workProjects.map((p) => (
            <a
              href={projectHref(p.slug)}
              data-transition-line1={t(p.transitionKey as UIKey)}
              data-transition-line2=""
              class="mobile-menu-link mobile-work-link text-muted text-[18px] font-normal tracking-[-0.3px] hover:text-ink transition-colors duration-200"
            >
              <span class="opacity-50 mr-2 text-[14px] font-mono">{p.num}</span>
              {t(p.labelKey)}
            </a>
          ))}
        </div>
      </div>
      <a
        href="mailto:hey@alvaroar.es"
        class="mobile-menu-link text-ink text-[32px] font-semibold tracking-[-0.6px]"
      >{t('nav.contact.talk')}</a>
    </div>

    {/* Bottom: email, socials, controls */}
    <div class="flex flex-col gap-xl">
      {/* Controls row */}
      <div class="flex items-center justify-center gap-lg">
        <button class="theme-knob theme-knob-mobile" aria-label="Toggle color theme" data-theme-knob-mobile>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <LanguageSwitcher />
      </div>

      {/* Divider */}
      <div class="h-px bg-border mx-auto w-full"></div>

      {/* Email */}
      <a href="mailto:hey@alvaroar.es" class="block text-center text-muted text-[14px] tracking-[-0.2px] hover:text-ink transition-colors duration-200">
        hey@alvaroar.es
      </a>

      {/* Socials */}
      <div class="flex items-center justify-center gap-lg">
        <a href="https://linkedin.com/in/alvaroares" target="_blank" rel="noopener" class="text-muted text-[13px] tracking-[-0.2px] hover:text-ink transition-colors duration-200">LinkedIn</a>
        <a href="https://instagram.com/alvaroar.es" target="_blank" rel="noopener" class="text-muted text-[13px] tracking-[-0.2px] hover:text-ink transition-colors duration-200">Instagram</a>
        <a href="https://vimeo.com/alvaroares" target="_blank" rel="noopener" class="text-muted text-[13px] tracking-[-0.2px] hover:text-ink transition-colors duration-200">Vimeo</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
  :root,
  [data-theme="warm"] {
    --accent: #e8a838;
    --accent-light: #fdf6e8;
    --accent-rgb: 232, 168, 56;
  }

  [data-theme="cold"] {
    --accent: #2596a8;
    --accent-light: #eaf4f6;
    --accent-rgb: 37, 150, 168;
  }
</style>

<style>
  #main-nav {
    background-color: transparent;
    transition: background-color 0.4s ease;
  }

  #main-nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--color-canvas) 90%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav-char-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    position: relative;
  }

  .nav-text {
    display: inline-block;
  }

  .nav-char {
    display: inline-block;
    will-change: transform;
  }

  .nav-about {
    color: var(--color-muted);
    transition: color 0.25s ease;
  }

  .nav-about:hover {
    color: var(--color-ink);
  }

  /* ── Work trigger ── */
  .nav-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--color-muted);
    transition: color 0.25s ease;
    gap: 5px;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"] {
    color: var(--color-ink);
  }

  .work-chevron {
    width: 10px;
    height: 10px;
    margin-top: 1px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.7;
  }

  .nav-trigger[aria-expanded="true"] .work-chevron {
    transform: rotate(180deg);
  }

  /* ── Work dropdown panel ── */
  .work-dropdown {
    position: absolute;
    top: 56px;
    right: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 49;
  }

  .work-dropdown.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .work-dropdown-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8px 32px 0 32px;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .work-dropdown-inner {
      padding-left: 64px;
      padding-right: 64px;
    }
  }

  .work-dropdown-panel {
    width: 100%;
    max-width: 420px;
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .work-dropdown-item {
    display: grid;
    grid-template-columns: 32px 1fr 14px;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-muted);
    position: relative;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .work-dropdown-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 2px;
    height: 0;
    background: var(--accent);
    border-radius: 2px;
    transform: translateY(-50%);
    transition: height 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-dropdown-item:hover,
  .work-dropdown-item:focus-visible {
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    color: var(--color-ink);
  }

  .work-dropdown-item:hover::before,
  .work-dropdown-item:focus-visible::before {
    height: 60%;
  }

  .work-item-num {
    font-family: var(--font-accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ghost);
    font-variant-numeric: tabular-nums;
  }

  .work-dropdown-item:hover .work-item-num {
    color: var(--accent);
  }

  .work-item-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .work-item-label {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.1;
    color: inherit;
  }

  .work-item-tag {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--color-ghost);
    line-height: 1.2;
  }

  .work-item-arrow {
    width: 14px;
    height: 14px;
    opacity: 0.5;
    transform: translateX(-3px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .work-dropdown-item:hover .work-item-arrow {
    transform: translateX(0);
    opacity: 1;
    color: var(--accent);
  }

  /* Theme knob */
  .theme-knob {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-muted);
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    position: relative;
  }

  .theme-knob:hover {
    transform: scale(1.1);
    border-color: var(--theme-knob-hover-color, var(--color-ink));
  }

  .theme-knob:active {
    transform: scale(0.92);
  }

  .theme-icon-sun,
  .theme-icon-moon {
    width: 14px;
    height: 14px;
    position: absolute;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .theme-icon-sun {
    color: #e8a838;
    opacity: 0;
    transform: scale(0.6);
  }

  .theme-icon-moon {
    color: #2596a8;
    opacity: 1;
    transform: scale(1);
  }

  .theme-knob.is-cold {
    --theme-knob-hover-color: #e8a838;
  }

  .theme-knob:not(.is-cold) {
    --theme-knob-hover-color: #2596a8;
  }

  .theme-knob.is-cold .theme-icon-sun {
    opacity: 1;
    transform: scale(1);
  }

  .theme-knob.is-cold .theme-icon-moon {
    opacity: 0;
    transform: scale(0.6);
  }

  /* ── Burger ── */
  .burger-btn {
    background: none;
    border: none;
    padding: 0;
  }

  .burger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-ink);
    border-radius: 1px;
    position: absolute;
    transition: transform 0.35s cubic-bezier(0.77, 0, 0.18, 1),
                opacity 0.2s ease;
  }

  .burger-line-1 {
    transform: translateY(-4px);
  }

  .burger-line-2 {
    transform: translateY(4px);
  }

  .burger-btn.is-open .burger-line-1 {
    transform: rotate(45deg);
  }

  .burger-btn.is-open .burger-line-2 {
    transform: rotate(-45deg);
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    visibility: hidden;
  }

  .mobile-menu.is-visible {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .mobile-menu.is-visible .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 80px;
    padding-bottom: 40px;
  }

  .mobile-menu-link {
    opacity: 0;
    transform: translateY(20px);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .work-dropdown {
      transition: opacity 0.1s ease;
      transform: none;
    }
    .work-chevron,
    .work-item-arrow,
    .work-dropdown-item::before {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  /* ── Theme Toggle ── */
  const STORAGE_KEY = 'aa-theme';
  const root = document.documentElement;
  const stored = localStorage.getItem(STORAGE_KEY);
  const initial = stored === 'cold' || stored === 'warm' ? stored : 'warm';
  root.setAttribute('data-theme', initial);

  function syncKnob(el: HTMLButtonElement | null, theme: string) {
    if (!el) return;
    el.classList.toggle('is-cold', theme === 'cold');
    el.setAttribute('aria-pressed', String(theme === 'warm'));
  }

  const desktopKnob = document.querySelector<HTMLButtonElement>('[data-theme-knob]');
  const mobileKnob = document.querySelector<HTMLButtonElement>('[data-theme-knob-mobile]');

  syncKnob(desktopKnob, initial);
  syncKnob(mobileKnob, initial);

  function toggleTheme() {
    const current = root.getAttribute('data-theme') || 'warm';
    const next = current === 'warm' ? 'cold' : 'warm';
    root.setAttribute('data-theme', next);
    localStorage.setItem(STORAGE_KEY, next);
    syncKnob(desktopKnob, next);
    syncKnob(mobileKnob, next);
  }

  desktopKnob?.addEventListener('click', toggleTheme);
  mobileKnob?.addEventListener('click', toggleTheme);

  /* ── Mobile menu ── */
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const menuContent = menu?.querySelector<HTMLElement>('[data-menu-content]');
  const menuLinks = menuContent?.querySelectorAll<HTMLElement>('.mobile-menu-link') ?? [];
  let isOpen = false;
  let menuTl: gsap.core.Timeline | null = null;

  function openMenu() {
    if (!menu || !menuContent || isOpen) return;
    isOpen = true;
    burger?.classList.add('is-open');
    burger?.setAttribute('aria-expanded', 'true');
    burger?.setAttribute('aria-label', 'Close menu');
    menu.classList.add('is-visible');
    document.body.style.overflow = 'hidden';

    if (menuTl) menuTl.kill();
    menuTl = gsap.timeline();
    menuTl
      .fromTo(menuContent, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' })
      .fromTo(menuLinks, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, stagger: 0.08, ease: 'power3.out' }, '-=0.1');
  }

  function closeMenu() {
    if (!menu || !menuContent || !isOpen) return;
    isOpen = false;
    burger?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';

    if (menuTl) menuTl.kill();
    menuTl = gsap.timeline({
      onComplete: () => {
        if (!isOpen) menu.classList.remove('is-visible');
      },
    });
    menuTl
      .to(menuLinks, { y: 16, opacity: 0, duration: 0.2, stagger: 0.04, ease: 'power2.in' })
      .to(menuContent, { opacity: 0, duration: 0.25, ease: 'power2.in' }, '-=0.1');
  }

  burger?.addEventListener('click', () => {
    isOpen ? closeMenu() : openMenu();
  });

  // Close on link click
  menuLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });

  // Close if resized to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isOpen) closeMenu();
  });

  /* ── Per-character hover ── */
  document.querySelectorAll<HTMLElement>('.nav-char-link').forEach((link) => {
    const chars = link.querySelectorAll<HTMLElement>('.nav-char');
    if (!chars.length) return;

    let hoverTween: gsap.core.Tween | null = null;

    link.addEventListener('mouseenter', () => {
      if (hoverTween) hoverTween.kill();
      hoverTween = gsap.to(chars, {
        y: -2,
        duration: 0.2,
        stagger: 0.02,
        ease: 'power2.out',
      });
    });

    link.addEventListener('mouseleave', () => {
      if (hoverTween) hoverTween.kill();
      hoverTween = gsap.to(chars, {
        y: 0,
        duration: 0.2,
        stagger: 0.02,
        ease: 'power2.in',
      });
    });
  });

  /* ── Work dropdown ── */
  const workTrigger = document.querySelector<HTMLButtonElement>('[data-work-trigger]');
  const workDropdown = document.querySelector<HTMLElement>('[data-work-dropdown]');
  const workItems = workDropdown?.querySelectorAll<HTMLElement>('.work-dropdown-item') ?? [];
  let workOpen = false;
  let workCloseTimer: number | null = null;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function openWork() {
    if (!workTrigger || !workDropdown || workOpen) return;
    if (workCloseTimer) {
      clearTimeout(workCloseTimer);
      workCloseTimer = null;
    }
    workOpen = true;
    workTrigger.setAttribute('aria-expanded', 'true');
    workDropdown.classList.add('is-open');

    if (!prefersReducedMotion) {
      gsap.fromTo(
        workItems,
        { y: -6, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.32, stagger: 0.04, ease: 'power3.out' }
      );
    }
  }

  function closeWork(immediate = false) {
    if (!workTrigger || !workDropdown || !workOpen) return;
    if (workCloseTimer) {
      clearTimeout(workCloseTimer);
      workCloseTimer = null;
    }
    workOpen = false;
    workTrigger.setAttribute('aria-expanded', 'false');
    if (immediate || prefersReducedMotion) {
      workDropdown.classList.remove('is-open');
    } else {
      const dur = 0.18;
      gsap.to(workItems, {
        y: -4,
        opacity: 0,
        duration: dur,
        stagger: 0.02,
        ease: 'power2.in',
        onComplete: () => {
          if (!workOpen) workDropdown.classList.remove('is-open');
        },
      });
    }
  }

  function scheduleClose() {
    if (workCloseTimer) clearTimeout(workCloseTimer);
    workCloseTimer = window.setTimeout(() => closeWork(), 120);
  }

  if (workTrigger && workDropdown) {
    // Hover open
    workTrigger.addEventListener('mouseenter', openWork);
    workTrigger.addEventListener('mouseleave', scheduleClose);
    workDropdown.addEventListener('mouseenter', () => {
      if (workCloseTimer) {
        clearTimeout(workCloseTimer);
        workCloseTimer = null;
      }
    });
    workDropdown.addEventListener('mouseleave', scheduleClose);

    // Click toggle (touch + keyboard accessibility)
    workTrigger.addEventListener('click', (e) => {
      e.preventDefault();
      workOpen ? closeWork(true) : openWork();
    });

    // Close on link click
    workItems.forEach((item) => {
      item.addEventListener('click', () => closeWork(true));
    });

    // Keyboard: Escape closes
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && workOpen) {
        closeWork(true);
        workTrigger.focus();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!workOpen) return;
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (!workTrigger.contains(target) && !workDropdown.contains(target)) {
        closeWork(true);
      }
    });
  }
</script>
