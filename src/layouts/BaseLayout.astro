---
import { defaultLang, type Language } from '@i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Language;
const path = Astro.url.pathname;

// hreflang links for SEO
const cleanPath = path.replace(/^\/(en|es)/, '') || '/';
const enHref = cleanPath === '/' ? 'https://alvaroar.es/' : `https://alvaroar.es${cleanPath}`;
const esHref = cleanPath === '/' ? 'https://alvaroar.es/es/' : `https://alvaroar.es/es${cleanPath}`;
const canonicalUrl = `https://alvaroar.es${path === '/' ? '/' : path}`;

const isHome = path === '/' || path === '/es/' || path === '/es';

import PageTransition from '@components/PageTransition.astro';

interface Props {
  title: string;
  description?: string;
  transitionLine1?: string;
  transitionLine2?: string;
  ogType?: 'website' | 'profile' | 'article';
  pubDateIso?: string;
  authorName?: string;
}

const { title, description = lang === 'es'
  ? 'Álvaro Ares — Director Creativo y artista CGI en Barcelona.'
  : 'Álvaro Ares — Creative Director & CGI artist based in Barcelona.', transitionLine1, transitionLine2, ogType, pubDateIso, authorName = 'Álvaro Ares' } = Astro.props;

const resolvedOgType = ogType ?? (isHome ? 'website' : 'profile');

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Álvaro Ares',
  url: 'https://alvaroar.es',
  jobTitle: lang === 'es' ? 'Director Creativo y Artista CGI' : 'Creative Director & CGI Artist',
  description,
  email: 'hey@alvaroar.es',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barcelona',
    addressCountry: 'ES',
  },
  sameAs: [
    'https://linkedin.com/in/alvaroares',
  ],
  knowsAbout: [
    'Creative Direction',
    'CGI',
    'Motion Design',
    'Brand Identity',
    '3D Rendering',
    'Art Direction',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Álvaro Ares',
  url: 'https://alvaroar.es',
  inLanguage: ['en', 'es'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="940075CA63F85940CBB9720244681AAD" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Álvaro Ares" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />

    {pubDateIso && <meta property="article:published_time" content={pubDateIso} />}
    {pubDateIso && <meta property="article:author" content={authorName} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {ogType === 'article' && pubDateIso && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: pubDateIso,
        author: {
          '@type': 'Person',
          name: authorName,
          url: 'https://alvaroar.es',
        },
        publisher: {
          '@type': 'Person',
          name: 'Álvaro Ares',
          url: 'https://alvaroar.es',
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
        inLanguage: lang,
      })} />
    )}

    <script is:inline>
      // Force unregister ALL service workers (zombie SW cleanup)
      (function() {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function(registrations) {
            for (var i = 0; i < registrations.length; i++) {
              registrations[i].unregister();
            }
          });
          if ('caches' in window) {
            caches.keys().then(function(cacheNames) {
              cacheNames.forEach(function(cacheName) {
                caches.delete(cacheName);
              });
            });
          }
        }
      })();
    </script>

    <script is:inline>
      (function() {
        var path = window.location.pathname;
        if (/^\/(en|es)(\/|$)/.test(path)) return;
        if (path.startsWith('/_') || path.startsWith('/api/') || path.startsWith('/@') || path.startsWith('/__')) return;

        function getCookie(name) {
          var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return match ? match[2] : null;
        }
        function setCookie(name, value, days) {
          var expires = new Date(Date.now() + days * 864e5).toUTCString();
          document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/';
        }

        var cookie = getCookie('aa-lang');
        if (cookie === 'es') {
          window.location.href = '/es' + (path === '/' ? '' : path);
        } else if (!cookie) {
          var preferred = (navigator.language || '').slice(0, 2).toLowerCase();
          if (preferred === 'es') {
            setCookie('aa-lang', 'es', 365);
            window.location.href = '/es' + (path === '/' ? '' : path);
          } else {
            setCookie('aa-lang', 'en', 365);
          }
        }
      })();
    </script>
  </head>
  <body>
    <PageTransition line1={transitionLine1} line2={transitionLine2} />
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<script>
  document.querySelectorAll('a').forEach((link) => {
    const href = link.getAttribute('href');
    if (!href || !href.startsWith('/') || (href.includes('#') && !link.dataset.transitionLine1) || link.hasAttribute('download') || link.getAttribute('target') === '_blank') return;

    if (href === window.location.pathname) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
      });
      return;
    }

    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (!link.dataset.transitionLine1) return;

      const overlay = document.getElementById('page-transition');
      if (overlay) {
        e.preventDefault();
        // Cancelar animación de entrada, forzar reflow, mostrar overlay limpio
        overlay.classList.remove('is-animating');
        void overlay.offsetHeight;
        overlay.classList.add('is-exiting');
        setTimeout(() => {
          window.location.href = href;
        }, 200);
      }
    });
  });
</script>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const animatedSelectors = ['.marquee-track', '.accent-dot', '.lab-pulse-card'];
    const animatedElements = document.querySelectorAll(animatedSelectors.join(','));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            el.style.animationPlayState = 'running';
          } else {
            el.style.animationPlayState = 'paused';
          }
        });
      },
      { threshold: 0.1 }
    );

    animatedElements.forEach((el) => observer.observe(el));
  }
</script>
